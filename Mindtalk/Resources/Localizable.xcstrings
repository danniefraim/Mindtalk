            "value": "Names you give speakers in a meeting are suggested for the list. The full list is under Vocabulary."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn du ger talarna i ett möte föreslås till listan. Hela listan finns under Ordlista."
