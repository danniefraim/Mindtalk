{
  "sourceLanguage": "sv",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "comment": "System Audio Recording permission",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindtalk includes Mac audio in a meeting, so what others say on a Teams, Zoom or Meet call is transcribed too. Everything is processed on your Mac, and no audio leaves it."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindtalk tar med datorns ljud i ett möte, så att de andra i ett samtal i Teams, Zoom eller Meet också skrivs ned. Allt tolkas på din Mac, och inget ljud lämnar datorn."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Mindact Solutions AB. Speech recognition: Klang Pianissimo by Klang AI AB and Parakeet Ultra by Moondream (CC BY 4.0)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Mindact Solutions AB. Taligenkänning: Klang Pianissimo av Klang AI AB och Parakeet Ultra av Moondream (CC BY 4.0)."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindtalk uses the microphone while you dictate and when you record meetings. Everything is transcribed on your Mac, and no audio leaves your computer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindtalk använder mikrofonen när du dikterar och när du spelar in möten. Allt tolkas på din Mac, och inget ljud lämnar datorn."
          }
        }
      }
    }
  },
  "version": "1.0"
}