    "Håller isär vem som pratar i ett möte. Möten kan inte spelas in utan den.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells apart who is speaking in a meeting. Meetings can't be recorded without it."
          }
        },
