    "Med Bara tankar läses inga möten, oavsett mapp.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Thoughts only, no meetings are read, whatever the folder."
