    "Hjälpmedel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel"
          }
        }
      }
    },
    "Hjälpmedel heter det i macOS. Det låter Mindtalk känna när du trycker på tangenten och skriva in texten åt dig. Utan det händer ingenting när du trycker.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS calls it Accessibility. It lets Mindtalk notice when you press the key and type the text for you. Without it, nothing happens when you press."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel heter det i macOS. Det låter Mindtalk känna när du trycker på tangenten och skriva in texten åt dig. Utan det händer ingenting när du trycker."
          }
        }
      }
    },
    "Hjälpmedel saknas": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility missing"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel saknas"
          }
        }
      }
    },
    "Hjälpmedel är avstängt för Mindtalk, så texten skrevs inte in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is off for Mindtalk, so the text wasn’t typed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel är avstängt för Mindtalk, så texten skrevs inte in."
          }
        }
      }
    },
