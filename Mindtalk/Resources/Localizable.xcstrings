    "%@ betyder %@ i de flesta appar. Mindtalk tar över den överallt medan appen är igång, så ⌃⌥ och en bokstav är ett säkrare val.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ means %2$@ in most apps. Mindtalk takes it over everywhere while it’s running, so ⌃⌥ and a letter is a safer choice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ betyder %@ i de flesta appar. Mindtalk tar över den överallt medan appen är igång, så ⌃⌥ och en bokstav är ett säkrare val."
          }
        }
      }
    },
    "%@ finns inte kvar på disken. Ladda ned den igen under Inställningar → Möten, eller välj en annan där.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer on the disk. Download it again under Settings → Meetings, or choose another one there."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns inte kvar på disken. Ladda ned den igen under Inställningar → Möten, eller välj en annan där."
          }
        }
      }
    },
    "%@ finns inte kvar på disken. Ladda ned den igen under Inställningar → Sammanfattningar, eller välj en annan där.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
