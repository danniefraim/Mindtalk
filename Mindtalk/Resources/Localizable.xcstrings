    "Namnet tas bort i det här mötet. Mindtalk känner fortfarande igen rösten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is removed from this meeting. Mindtalk still recognizes the voice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet tas bort i det här mötet. Mindtalk känner fortfarande igen rösten."
          }
        }
      }
    },
    "Namnge en röst en gång, så känner Mindtalk igen den. Inget ljud sparas. Fråga de andra först.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a voice once and Mindtalk will know it. No audio is kept. Ask the others first."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnge en röst en gång, så känner Mindtalk igen den. Inget ljud sparas. Fråga de andra först."
          }
        }
      }
    },
    "Namnge talarna under mötet om du vill.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the speakers during the meeting if you like."
