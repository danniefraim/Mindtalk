          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp när du är klar, så hamnar texten där markören står. Esc avbryter."
          }
        }
      }
    },
    "Släpp när du är klar, så sparas tanken här. Tryck kort för att låsa och prata fritt. Esc avbryter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go when you’re done, and the thought is saved here. Tap once to lock and talk hands-free. Esc cancels."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp när du är klar, så sparas tanken här. Tryck kort för att låsa och prata fritt. Esc avbryter."
          }
        }
      }
    },
