          "stringUnit": {
            "state": "translated",
            "value": "Written by %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivs av %@."
          }
        }
      }
    },
    "Skärm- och systemljudsinspelning heter det i macOS. Mindtalk tar bara ljudet från samtalsappar medan ett möte spelas in, aldrig skärmen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS calls it Screen & System Audio Recording. Mindtalk only takes the sound of call apps while a meeting is recorded, never the screen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärm- och systemljudsinspelning heter det i macOS. Mindtalk tar bara ljudet från samtalsappar medan ett möte spelas in, aldrig skärmen."
          }
        }
      }
    },
    "Sluta känna igen %@": {
