    "Texten kan inte skrivas just nu. Ljudet spelas in och skrivs ned efter mötet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text can’t be written right now. The audio is being recorded and will be written out after the meeting."
          }
        },
