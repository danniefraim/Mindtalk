    "Inspelningarna, texterna, dina anteckningar och sammanfattningarna flyttas till papperskorgen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recordings, transcripts, your notes and the summaries are moved to the Trash."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningarna, texterna, dina anteckningar och sammanfattningarna flyttas till papperskorgen."
          }
        }
      }
    },
    "Inspelningen av mötet kunde inte läsas, så mötet går inte att fortsätta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting’s recording couldn’t be read, so it can’t be continued."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen av mötet kunde inte läsas, så mötet går inte att fortsätta."
          }
        }
      }
    },
    "Inspelningen avbröts innan mötet var klart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording stopped before the meeting was over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen avbröts innan mötet var klart."
          }
        }
      }
    },
    "Inspelningen flyttas till papperskorgen. Texten, dina anteckningar och sammanfattningen finns kvar, men det går inte längre att lyssna på mötet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is moved to the Trash. The text, your notes and the summary stay, but you can no longer listen to the meeting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen flyttas till papperskorgen. Texten, dina anteckningar och sammanfattningen finns kvar, men det går inte längre att lyssna på mötet."
          }
        }
      }
    },
    "Inspelningen kan inte sparas. Är disken full? Texten skrivs ändå.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording can’t be saved. Is the disk full? The text is still written."
          }
        },
