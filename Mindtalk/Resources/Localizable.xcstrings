    },
    "%@ finns på din Mac och läser många möten mer noggrant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is on your Mac and reads many meetings more carefully."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns på din Mac och läser många möten mer noggrant."
          }
        }
      }
    },
    "%@ från Google hittar fler beslut och uppgifter och skriver dem på din Mac. Den behöver %@ ledigt. Du har %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from Google finds more decisions and tasks and writes them on your Mac. It needs %2$@ free. You have %3$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ från Google hittar fler beslut och uppgifter och skriver dem på din Mac. Den behöver %@ ledigt. Du har %@."
          }
        }
      }
    },
    "%@ från Google hittar fler beslut och uppgifter och skriver dem på din Mac. Den laddas ned en gång (%@) och fungerar sedan utan internet. Du har %@ ledigt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from Google finds more decisions and tasks and writes them on your Mac. It’s downloaded once (%2$@) and then works without internet. You have %3$@ free."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ från Google hittar fler beslut och uppgifter och skriver dem på din Mac. Den laddas ned en gång (%@) och fungerar sedan utan internet. Du har %@ ledigt."
          }
        }
      }
    },
    "%@ från Google hittar fler beslut och uppgifter och skriver dem på din Mac. Den laddas ned en gång (%@) och fungerar sedan utan internet. Du har %lld GB ledigt.": {
