    },
    "Inspelningen avbröts innan mötet var klart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording stopped before the meeting was over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen avbröts innan mötet var klart."
          }
        }
      }
    },
    "Inspelningen flyttas till papperskorgen. Texten, dina anteckningar och sammanfattningen finns kvar, men det går inte längre att lyssna på mötet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is moved to the Trash. The text, your notes and the summary stay, but you can no longer listen to the meeting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen flyttas till papperskorgen. Texten, dina anteckningar och sammanfattningen finns kvar, men det går inte längre att lyssna på mötet."
          }
        }
      }
    },
    "Inspelningen kan inte sparas. Är disken full? Texten skrivs ändå.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording can’t be saved. Is the disk full? The text is still written."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen kan inte sparas. Är disken full? Texten skrivs ändå."
          }
        }
      }
    },
    "Inspelningen är borttagen, så det går inte att spela in mer i mötet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording has been removed, so you can’t record more in this meeting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen är borttagen, så det går inte att spela in mer i mötet."
          }
        }
      }
    },
    "Inspelningen är igång, inget går förlorat.": {
