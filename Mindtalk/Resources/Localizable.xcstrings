    },
    "Släpp en ljud- eller videofil här, så blir den ett möte med text, talare och sammanfattning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop an audio or video file here, and it becomes a meeting with text, speakers and a summary."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp en ljud- eller videofil här, så blir den ett möte med text, talare och sammanfattning."
          }
        }
      }
    },
    "Släpp när du är klar, så hamnar texten där markören står. Dubbeltryck eller tryck mellanslag så slipper du hålla in. Esc avbryter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go when you’re done and the text lands at your cursor. Double-tap or press space so you don’t have to hold. Esc cancels."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp när du är klar, så hamnar texten där markören står. Dubbeltryck eller tryck mellanslag så slipper du hålla in. Esc avbryter."
          }
        }
      }
    },
    "Släpp när du är klar, så hamnar texten där markören står. Esc avbryter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
